<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingHorizontal="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:id="@+id/cl_profile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ① 프로필 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Pwfb.Card.Hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tv_avatar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="?attr/colorPrimary"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="?attr/colorOnPrimary"
                    tools:text="오" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="오기용" />

                    <TextView
                        android:id="@+id/tv_ideal_weight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorPrimary"
                        tools:text="이상적인 공복 체중 : 80.8~81.6Kg" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ② 목표 수정 (체중 · D-Day) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="24dp"
            android:text="@string/profile_goal"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cl_modify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/kr_empty_stomach_weight"
                    android:textAppearance="@style/TextAppearance.Pwfb.Eyebrow" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bt_minus"
                        style="@style/Widget.Pwfb.IconButton"
                        android:contentDescription="@string/iv_minus_description"
                        app:icon="@drawable/ic_remove" />

                    <TextView
                        android:id="@+id/tv_weight"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:textAppearance="?attr/textAppearanceHeadlineMedium"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="81.6Kg" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bt_plus"
                        style="@style/Widget.Pwfb.IconButton"
                        android:contentDescription="@string/iv_plus_description"
                        app:icon="@drawable/ic_add" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="20dp"
                    android:background="?attr/colorOutlineVariant" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/profile_d_day"
                        android:textAppearance="@style/TextAppearance.Pwfb.Eyebrow" />

                    <TextView
                        android:id="@+id/tv_d_day"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textColor="?attr/colorPrimary"
                        tools:text="D-7" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bt_date"
                    style="@style/Widget.Pwfb.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:icon="@drawable/ic_calendar"
                    tools:text="2026.10.27(화)" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bt_time"
                    style="@style/Widget.Pwfb.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:icon="@drawable/ic_schedule"
                    tools:text="오후 06:00" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bt_modify"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:enabled="false"
                    android:text="@string/modify" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ③ 더보기 메뉴 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="4dp">

                <LinearLayout
                    android:id="@+id/cl_the_day_strategy"
                    style="@style/Widget.Pwfb.MenuRow">

                    <ImageView
                        style="@style/Widget.Pwfb.MenuRow.Icon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_bolt" />

                    <TextView
                        style="@style/Widget.Pwfb.MenuRow.Text"
                        android:text="@string/the_day_strategy_1" />

                    <ImageView
                        style="@style/Widget.Pwfb.MenuRow.Chevron"
                        android:contentDescription="@null" />
                </LinearLayout>

                <View style="@style/Widget.Pwfb.MenuRow.Divider" />

                <LinearLayout
                    android:id="@+id/cl_pwfb_information"
                    style="@style/Widget.Pwfb.MenuRow">

                    <ImageView
                        style="@style/Widget.Pwfb.MenuRow.Icon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_info" />

                    <TextView
                        style="@style/Widget.Pwfb.MenuRow.Text"
                        android:text="@string/pwfb_information" />

                    <ImageView
                        style="@style/Widget.Pwfb.MenuRow.Chevron"
                        android:contentDescription="@null" />
                </LinearLayout>

                <View style="@style/Widget.Pwfb.MenuRow.Divider" />

                <LinearLayout
                    android:id="@+id/cl_log_send"
                    style="@style/Widget.Pwfb.MenuRow">

                    <ImageView
                        style="@style/Widget.Pwfb.MenuRow.Icon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_upload" />

                    <TextView
                        style="@style/Widget.Pwfb.MenuRow.Text"
                        android:text="@string/log_send" />

                    <ImageView
                        style="@style/Widget.Pwfb.MenuRow.Chevron"
                        android:contentDescription="@null" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
