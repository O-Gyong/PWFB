<?xml version="1.0" encoding="utf-8"?><!--
   API 31 이상 백업/기기 이전 규칙
   - 사용자 설정(DataStore, files/datastore/)은 기본 포함
   - 오류 로그(files/logs/)는 기기별 진단용이므로 제외
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="logs" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="logs" />
    </device-transfer>
</data-extraction-rules>
