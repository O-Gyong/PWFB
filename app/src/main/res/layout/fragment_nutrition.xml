<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingHorizontal="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include
            android:id="@+id/header"
            layout="@layout/view_dday_header" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="24dp"
            android:text="@string/nutrition_section_title"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <include android:id="@+id/carbohydrate" layout="@layout/view_nutrition_input" />
        <include android:id="@+id/protein" layout="@layout/view_nutrition_input" />
        <include android:id="@+id/fat" layout="@layout/view_nutrition_input" />
        <include android:id="@+id/water" layout="@layout/view_nutrition_input" />
        <include android:id="@+id/sodium" layout="@layout/view_nutrition_input" />
        <include android:id="@+id/potassium" layout="@layout/view_nutrition_input" />
        <include android:id="@+id/creatine" layout="@layout/view_nutrition_input" />
        <include android:id="@+id/dietary_fiber" layout="@layout/view_nutrition_input" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
