<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name="com.pwfb.PwfbApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Pwfb"
        tools:targetApi="tiramisu">

        <activity
            android:name="com.pwfb.presentation.splash.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.pwfb.presentation.MainActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.pwfb.presentation.setting.NameActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.pwfb.presentation.setting.WeightActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.pwfb.presentation.setting.DayActivity" />

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${AdMobAPI_KEY}"/>
    </application>
</manifest>